---
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import BaseHead from "../../components/BaseHead.astro";
import { getCollection } from 'astro:content';
import ArtGallery from '../../components/ArtGallery.astro';
function slugify(str) {
  return str ? str.toLowerCase().replace(/\s+/g, '-') : '';
}

export async function getStaticPaths() {
  const items = await getCollection('art');
  return [...new Set(items.map(a => a.data.medium))].map(m => ({ params: { medium: m.toLowerCase().replace(/\s+/g, '-') } }));
}
const artItems = await getCollection('art');
const selectedMedium = artItems.find(a => a.data.medium.toLowerCase().replace(/\s+/g, '-') === Astro.params.medium)?.data.medium;
---
<html lang="en">
  <head>
    <BaseHead title="Art Gallery" description="Browse paintings by medium, availability and date." />
  </head>
  <body class="w-full max-w-screen-md mx-auto my-4 dark:bg-neutral-800 dark:text-neutral-300 transition-colors duration-300">
    <Header />
    <main class="flex flex-col gap-8 px-4 md:px-0">
<h1 class="text-3xl font-bold">Art</h1>
      <ArtGallery artItems={artItems} selectedMedium={selectedMedium} />
    </main>
    <Footer />
  </body>
</html>
